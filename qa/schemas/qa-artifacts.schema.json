{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contribo.local/qa/qa-artifacts.schema.json",
  "title": "Contribo QA artifacts",
  "type": "object",
  "$defs": {
    "environment": {
      "type": "object",
      "required": ["name", "version", "safeForTestData"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "baseUrl": {"type": "string"},
        "version": {"type": "string", "minLength": 1},
        "safeForTestData": {"const": true}
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": ["scenarioId", "feature", "preconditions", "steps", "expected", "priority", "status"],
      "properties": {
        "scenarioId": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "minLength": 1},
        "context": {"type": "string"},
        "preconditions": {"type": "array"},
        "data": {"type": "array"},
        "steps": {"type": "array", "minItems": 1},
        "expected": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "status": {"enum": ["Planned", "Réussi", "Échoué", "Bloqué", "Non applicable"]},
        "references": {"type": "array"}
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["resultId", "scenarioId", "status", "executedAt", "environment"],
      "properties": {
        "resultId": {"type": "string", "minLength": 1},
        "scenarioId": {"type": "string", "minLength": 1},
        "status": {"enum": ["Réussi", "Échoué", "Bloqué", "Non applicable"]},
        "executedAt": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "observation": {"type": "string"},
        "evidence": {"type": "array"}
      },
      "additionalProperties": true
    },
    "anomaly": {
      "type": "object",
      "required": ["anomalyId", "fingerprint", "scenarioId", "classification", "severity", "priority"],
      "properties": {
        "anomalyId": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "scenarioId": {"type": "string", "minLength": 1},
        "classification": {"enum": ["confirmed", "suspicion", "clarification", "technical-blocker"]},
        "severity": {"enum": ["Blocker", "Critical", "Major", "Minor", "Trivial"]},
        "priority": {"enum": ["P0", "P1", "P2"]}
      },
      "additionalProperties": true
    },
    "ticket": {
      "type": "object",
      "required": ["ticketId", "title", "feature", "description", "severity", "priority", "acceptanceCriteria", "regressionTests"],
      "properties": {
        "ticketId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "severity": {"enum": ["Blocker", "Critical", "Major", "Minor", "Trivial"]},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "acceptanceCriteria": {"type": "array", "minItems": 1},
        "regressionTests": {"type": "array", "minItems": 1}
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": ["runId", "schemaVersion", "profile", "environment", "artifacts", "traceability"],
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "schemaVersion": {"const": 1},
        "profile": {"enum": ["smoke", "full", "targeted"]},
        "environment": {"$ref": "#/$defs/environment"},
        "artifacts": {"type": "array", "minItems": 1},
        "traceability": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
