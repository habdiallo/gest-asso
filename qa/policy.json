{
  "version": 1,
  "allowedEnvironments": ["local", "integration", "staging", "recette"],
  "forbiddenEnvironments": ["production", "prod"],
  "sensitiveKeys": [
    "password",
    "token",
    "authorization",
    "cookie",
    "secret",
    "privateKey",
    "email",
    "phone"
  ],
  "sensitiveTextPatterns": [
    "Bearer\\s+[A-Za-z0-9._~-]+",
    "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9._-]+\\.[A-Za-z0-9._-]+"
  ],
  "irreversibleActions": ["delete", "disable", "close", "recordPayment", "recordContribution"],
  "retention": {
    "runDays": 90,
    "evidenceDays": 30
  }
}
