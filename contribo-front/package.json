{
  "name": "contribo-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "openapi-generator-cli generate --generator-key contribo-api",
    "validate:api": "openapi-generator-cli validate -i ../besoins/openapi.yaml",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:tooling": "node --test scripts/tooling.test.cjs",
    "lint": "ng lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
