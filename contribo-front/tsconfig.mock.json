/* Compile aussi src/main.mock.ts et les dossiers mocks/, exclus de tsconfig.app.json pour que
   la compilation normale (npm start, npm run build) reste indépendante du client API généré
   même lorsque les handlers de mock importent `@api`. Utilisé uniquement par la configuration
   Angular "mock" (npm run start:mock). */
{
  "extends": "./tsconfig.app.json",
  "exclude": ["src/**/*.spec.ts"]
}
