# Variables for compose.portainer.yaml, used by the Portainer stack.
# Copy to a secret-managed environment and replace placeholders.
SPRING_PROFILE=int

# Immutable image references from the same validated CI run.
BACKEND_IMAGE=ghcr.io/example/contribo-back@sha256:<backend-digest>
FRONTEND_IMAGE=ghcr.io/example/contribo-front@sha256:<frontend-digest>

# Existing PostgreSQL container on the Docker backend network.
DB_HOST=postgres-main
DB_PORT=5432
DB_NAME=contribo
DB_USERNAME=contribo
DB_PASSWORD_FILE_PATH=/opt/contribo/secrets/db_password

# Stable frontend IP on the stack-managed internal network.
INTERNAL_NETWORK_SUBNET=172.30.0.0/24
FRONTEND_INTERNAL_IP=172.30.0.10
TRUSTED_PROXY_HEADERS=true
TRUSTED_PROXY_ADDRESSES=172.30.0.10

# Absolute path on the Docker host, outside the Portainer data volume.
FRONTEND_NGINX_CONFIG_FILE_PATH=/etc/contribo/nginx/nginx.portainer.conf

# Application RSA keys, provisioned outside the repository.
RSA_PUBLIC_KEY_FILE_PATH=/opt/contribo/secrets/rsa_public.pem
RSA_PRIVATE_KEY_FILE_PATH=/opt/contribo/secrets/rsa_private.pem

# The compose file declares this secret even when bootstrap is disabled.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_IDENTIFIER=admin
BOOTSTRAP_ADMIN_PASSWORD_FILE_PATH=/opt/contribo/secrets/bootstrap_admin_password

# Existing external Docker networks.
DATABASE_NETWORK=backend
PROXY_NETWORK=frontend
INTERNAL_NETWORK=contribo-internal
