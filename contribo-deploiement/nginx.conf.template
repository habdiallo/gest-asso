# Rendu par envsubst au démarrage de l'image (seule variable : TRUSTED_PROXY_CIDR).
# TLS, redirection HTTPS et HSTS sont portés par le proxy d'entrée (Caddy).
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

include /etc/nginx/includes/nginx-rate-limits.conf;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    # Résolution à la requête : le frontend démarre même si le backend est absent.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $contribo_backend http://backend:8080;

    include /etc/nginx/includes/security-headers.conf;
    include /etc/nginx/includes/nginx-application-locations.conf;
}
