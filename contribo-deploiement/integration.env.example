# Copy to a secret-managed environment, never commit real values.
POSTGRES_DB=contribo
POSTGRES_USER=contribo
# These files are provisioned outside the repository by the environment.
DB_PASSWORD_FILE_PATH=/etc/contribo/secrets/db_password
JWT_SECRET_FILE_PATH=/etc/contribo/secrets/jwt_secret
# Never use latest, a branch tag, or another mutable tag. Prefer a release tag or digest.
BACKEND_IMAGE=ghcr.io/example/contribo-back:v0.1.0
FRONTEND_IMAGE=ghcr.io/example/contribo-front:v0.1.0
FRONTEND_PORT=8080
