# Copy to a secret-managed environment, never commit real values.
POSTGRES_DB=contribo
POSTGRES_USER=contribo
# These files are provisioned outside the repository by the environment.
DB_PASSWORD_FILE_PATH=/etc/contribo/secrets/db_password
RSA_PUBLIC_KEY_FILE_PATH=/etc/contribo/secrets/rsa_public.pem
RSA_PRIVATE_KEY_FILE_PATH=/etc/contribo/secrets/rsa_private.pem
# Never use latest, a branch tag, or another mutable tag. Prefer a release tag or digest.
BACKEND_IMAGE=ghcr.io/example/contribo-back:v0.1.0
FRONTEND_IMAGE=ghcr.io/example/contribo-front:v0.1.0
# Exact frontend container IP as observed by the backend. Comma-separated if needed.
TRUSTED_PROXY_ADDRESSES=<frontend-container-ip-as-seen-by-backend>
# These paths are mounted into the frontend container by Compose secrets.
TLS_CERTIFICATE_FILE_PATH=/etc/contribo/secrets/fullchain.pem
TLS_PRIVATE_KEY_FILE_PATH=/etc/contribo/secrets/privkey.pem
FRONTEND_HTTP_PORT=8080
FRONTEND_HTTPS_PORT=8443
